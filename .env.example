# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The chat where files get stored — usually a private channel or group
# you (the admin) created and added the bot to as an admin.
